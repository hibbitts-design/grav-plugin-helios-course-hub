{# Course card partial - doc-card variant with optional top or side image #}
{# Required vars: title, link (optional), icon (optional), description (optional), image (optional Grav media object), image_layout ('top'|'side', default 'top') #}
{% set tag = link ? 'a' : 'div' %}
{% set linkAttrs = link ? 'href="' ~ link ~ '"' : '' %}
{% set layout = image ? (image_layout|default('top')) : 'none' %}
{# a portrait image, such as a book cover, is shown whole on a light band in its usual space, instead of cropped to
   fill it – as in Helios Open Reader (see helios.css) #}
{% set image_portrait = image and image.get('height') > image.get('width') %}

<{{ tag }} {{ linkAttrs|raw }} class="doc-card group block rounded-lg border border-gray-200 dark:border-gray-700 {{ link ? (image ? 'cursor-pointer hover:!no-underline' : 'hover:border-primary dark:hover:border-primary cursor-pointer hover:!no-underline') : '' }} transition-colors {{ image ? 'course-card-has-image' : '' }} {{ layout == 'side' ? 'course-card-side-layout' : '' }}">
    {% if layout == 'top' %}
        <div class="course-card-image-container{{ image_portrait ? ' course-card-image--portrait' }}">
            <img src="{{ image.url }}" alt="">
        </div>
        <div class="p-6">
            {% include 'partials/course-card-content.html.twig' %}
        </div>
    {% elseif layout == 'side' %}
        <div class="course-card-side-image-container{{ image_portrait ? ' course-card-image--portrait' }}">
            <img src="{{ image.url }}" alt="">
        </div>
        <div class="p-6 course-card-side-content">
            {% include 'partials/course-card-content.html.twig' %}
        </div>
    {% else %}
        {% include 'partials/course-card-content.html.twig' %}
    {% endif %}
</{{ tag }}>
