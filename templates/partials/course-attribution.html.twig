{# A course's OER attribution and license (its Attribution tab), as in Helios Open Reader. Shown in the footer, and
   copied there by helios.js after an HTMX page swap, so it always matches the course of the page shown - hibbittsdesign.org #}
{% set attribution = course_attribution ?? null %}
{% if attribution and not chromeless %}
<div class="hch-attribution mt-4 mb-4 text-center text-sm text-gray-500 dark:text-gray-400">
    {% if attribution.text %}
    <p>{{ attribution.text|raw }}</p>
    {% endif %}
    {# the license on its own line, unless the attribution text already names it (as in "licensed under CC BY 4.0") #}
    {% if attribution.license and not (attribution.text and attribution.license in attribution.text) %}
    <p class="mt-2">
        {% if attribution.license_url %}
        <a href="{{ attribution.license_url }}" target="_blank" rel="noopener noreferrer" class="hover:underline">
            {{ attribution.license }}<span class="sr-only"> {{ 'PLUGIN_HELIOS_COURSE_HUB.OPENS_IN_NEW_TAB'|t }}</span>
        </a>
        {% else %}
        {{ attribution.license }}
        {% endif %}
    </p>
    {% endif %}
</div>
{% endif %}
