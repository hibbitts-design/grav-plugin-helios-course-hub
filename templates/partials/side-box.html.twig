{# Side Box (side_box), as in Grav Helios Open Reader: the page's own, else the course's (course.md);
   none on the pages of a module set to false. Used by sidebar.html.twig and swap-body.html.twig #}
{% if page.template in ['course-page', 'module'] %}

    {% if page.header.side_box is defined %}
        {% set side_box = page.header.side_box %}
    {% else %}
        {% set side_box = course_side_box|default(null) %}
    {% endif %}

    {# the page's module has its Side Box turned off ("false" is also how Admin saves it) #}
    {% set module = page.parent %}
    {% set in_a_module = module.template in ['course-page', 'module'] %}
    {% set module_turned_off = module.header.side_box is defined and (not module.header.side_box or module.header.side_box == 'false') %}
    {% if page.header.side_box is not defined and in_a_module and module_turned_off %}
        {% set side_box = false %}
    {% endif %}

    {% if side_box and side_box != 'false' %}
        {{ side_box|markdown|shortcodes|raw }}
    {% endif %}
{% endif %}
