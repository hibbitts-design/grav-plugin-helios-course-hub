{#
 # Plugin override of partials/content/chapter.html.twig (based on Helios theme v3.5.7)
 # Changes from theme original:
 #   1. Child pages support optional grouping via group: "Label" in child page frontmatter;
 #      ungrouped children render first with no heading, grouped children follow under a labelled section
 # Note: grouping logic lives here (not in chapter.html.twig) so it applies to both full page
 #       and HTMX navigation renders.
 #}
<div class="not-prose mb-8">
    <h1 class="flex items-center gap-4 mb-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
        {% if page.header.icon %}
        <span class="flex-shrink-0 inline-flex items-center justify-center p-2 rounded-xl bg-primary/15 text-primary">
            {{ svg_icon(page.header.icon, 'w-6 h-6')|raw }}
        </span>
        {% endif %}
        <span>{{ page.title }}</span>
    </h1>
    {% if page.header.description or page.summary %}
    <p class="text-lg text-gray-600 dark:text-gray-400">
        {{ page.header.description ?: page.summary|striptags }}
    </p>
    {% endif %}
</div>

{% if page.content|trim %}
<div class="mb-12">{{ page.content|raw }}</div>
{% endif %}

{# Child pages with optional grouping. Set group: "Label" in child frontmatter.
   Ungrouped children render first with no heading; grouped children follow. #}
{% set children = page.children.visible %}
{% if children.count > 0 %}
    {% set groups = {} %}
    {% set group_order = [] %}
    {% for child in children %}
        {% set g = child.header.group ?? '' %}
        {% if g not in group_order %}
            {% set group_order = group_order|merge([g]) %}
            {% set groups = groups|merge({(g): []}) %}
        {% endif %}
        {% set groups = groups|merge({(g): groups[g]|merge([child])}) %}
    {% endfor %}

    {% for g in group_order %}
    {% if g %}
    <div class="pt-6 mb-10">
        <h2 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-4">{{ g }}</h2>
        <div class="grid gap-4 sm:grid-cols-2">
            {% for child in groups[g] %}
            <a href="{{ child.url }}"
               class="hover:!no-underline group block p-6 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-primary dark:hover:border-primary transition-colors">
                <h3 class="flex items-center !mt-3 gap-3 text-base font-semibold text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                    {% if child.header.icon %}
                    <span class="flex-shrink-0 inline-flex items-center justify-center p-2 rounded-xl bg-primary/15 text-primary">
                        {{ svg_icon(child.header.icon, 'w-5 h-5')|raw }}
                    </span>
                    {% endif %}
                    <span>{{ child.title }}</span>
                </h3>
                {% if child.header.description or child.summary %}
                <p class="mt-3 text-sm text-gray-600 dark:text-gray-400 line-clamp-2">
                    {{ child.header.description ?: child.summary|striptags }}
                </p>
                {% endif %}
            </a>
            {% endfor %}
        </div>
    </div>
    {% else %}
    <div class="grid gap-4 sm:grid-cols-2{% if group_order|length > 1 %} mb-10{% endif %}">
        {% for child in groups[g] %}
        <a href="{{ child.url }}"
           class="hover:!no-underline group block p-6 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-primary dark:hover:border-primary transition-colors">
            <h3 class="flex items-center !mt-3 gap-3 text-base font-semibold text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                {% if child.header.icon %}
                <span class="flex-shrink-0 inline-flex items-center justify-center p-2 rounded-xl bg-primary/15 text-primary">
                    {{ svg_icon(child.header.icon, 'w-5 h-5')|raw }}
                </span>
                {% endif %}
                <span>{{ child.title }}</span>
            </h3>
            {% if child.header.description or child.summary %}
            <p class="mt-3 text-sm text-gray-600 dark:text-gray-400 line-clamp-2">
                {{ child.header.description ?: child.summary|striptags }}
            </p>
            {% endif %}
        </a>
        {% endfor %}
    </div>
    {% endif %}
    {% endfor %}
{% endif %}
