{#
 # Plugin override of partials/content/chapter.html.twig (based on Helios theme v3.5.7)
 # Changes from theme original:
 #   1. Child pages support optional grouping via group: "Label" in child page frontmatter;
 #      ungrouped children render first with no heading, grouped children follow under a labelled section
 #   2. Child page cards show an optional badge (badge_label and badge_color), as on the course cards
 # Note: grouping logic lives here (not in chapter.html.twig) so it applies to both full page
 #       and HTMX navigation renders.
 #}
<div class="not-prose mb-8">
    <h1 class="flex items-center gap-4 mb-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
        {% if page.header.icon %}
        <span class="flex-shrink-0 inline-flex items-center justify-center p-2 rounded-xl bg-primary/15 text-primary">
            {{ svg_icon(page.header.icon, 'w-6 h-6')|raw }}
        </span>
        {% endif %}
        <span>{{ page.title }}</span>
    </h1>
    {% if page.header.description or page.summary %}
    <p class="text-lg text-gray-600 dark:text-gray-400">
        {{ page.header.description ?: page.summary|striptags }}
    </p>
    {% endif %}
</div>

{# Keep My Place: "Continue where you left off" (Grav Helios Open Reader's "Continue reading" strip), shown by
   assets/helios.js when the reader has been to one of this Modules page's pages (hidden until then, and when embedded).
   It can be turned off in the plugin settings, or for a course with keep_my_place: false on its course page #}
{% set course_keeps_place = page.parent.header.keep_my_place is not defined or page.parent.header.keep_my_place %}
{% if page.template == 'module' and course_keeps_place and config.plugins['helios-course-hub'].keep_my_place is not same as(false) and not chromeless %}
<div id="hor-resume-reading" class="hor-resume-strip not-prose" data-hor-publication-path="{{ page.url }}" hidden>
    <svg class="hor-resume-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" />
    </svg>
    <span class="hor-resume-text"><a id="hor-resume-btn" href="#">{{ 'PLUGIN_HELIOS_COURSE_HUB.CONTINUE_WHERE_LEFT_OFF'|t }}: <span id="hor-resume-title"></span></a></span>
    <button type="button" class="hor-resume-dismiss" aria-label="{{ 'PLUGIN_HELIOS_COURSE_HUB.FORGET_PLACE'|t|e('html_attr') }}">&#x2715;</button>
</div>
{% endif %}

{# On phones and tablets, the module's sections in an "On this page" box, above its content #}
{% include 'partials/page-sections-above.html.twig' %}

{% if page.content|trim %}
<div class="mb-12">{{ page.content|raw }}</div>
{% endif %}

{# Child pages with optional grouping. Set group: "Label" in child frontmatter.
   Ungrouped children render first with no heading; grouped children follow. #}
{% set children = page.children.visible %}
{% if children.count > 0 %}
    {# (each key starts with "g:", since Twig would renumber a group name that is a number, such as 2026) #}
    {% set groups = {} %}
    {% set group_order = [] %}
    {% for child in children %}
        {% set g = child.header.group ?? '' %}
        {% if g not in group_order %}
            {% set group_order = group_order|merge([g]) %}
            {% set groups = groups|merge({('g:' ~ g): []}) %}
        {% endif %}
        {% set groups = groups|merge({('g:' ~ g): groups['g:' ~ g]|merge([child])}) %}
    {% endfor %}

    {% for g in group_order %}
    {% if g %}
    <div class="pt-6 mb-10">
        <h2 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-4">{{ g }}</h2>
        <div class="grid gap-4 sm:grid-cols-2">
            {% for child in groups['g:' ~ g] %}
            <a href="{{ child.url }}"
               class="hover:!no-underline group block p-6 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-primary dark:hover:border-primary transition-colors">
                <h3 class="flex items-center !mt-3 gap-3 text-base font-semibold text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                    {% if child.header.icon %}
                    <span class="flex-shrink-0 inline-flex items-center justify-center p-2 rounded-xl bg-primary/15 text-primary">
                        {{ svg_icon(child.header.icon, 'w-5 h-5')|raw }}
                    </span>
                    {% endif %}
                    <span>{{ child.title }}</span>
                </h3>
                {% if child.header.description or child.summary %}
                <p class="mt-3 text-sm text-gray-600 dark:text-gray-400 line-clamp-2">
                    {{ child.header.description ?: child.summary|striptags }}
                </p>
                {% endif %}
                {% include 'partials/content/chapter-card-badge.html.twig' with { card_page: child } only %}
            </a>
            {% endfor %}
        </div>
    </div>
    {% else %}
    <div class="grid gap-4 sm:grid-cols-2{% if group_order|length > 1 %} mb-10{% endif %}">
        {% for child in groups['g:' ~ g] %}
        <a href="{{ child.url }}"
           class="hover:!no-underline group block p-6 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-primary dark:hover:border-primary transition-colors">
            <h3 class="flex items-center !mt-3 gap-3 text-base font-semibold text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                {% if child.header.icon %}
                <span class="flex-shrink-0 inline-flex items-center justify-center p-2 rounded-xl bg-primary/15 text-primary">
                    {{ svg_icon(child.header.icon, 'w-5 h-5')|raw }}
                </span>
                {% endif %}
                <span>{{ child.title }}</span>
            </h3>
            {% if child.header.description or child.summary %}
            <p class="mt-3 text-sm text-gray-600 dark:text-gray-400 line-clamp-2">
                {{ child.header.description ?: child.summary|striptags }}
            </p>
            {% endif %}
            {% include 'partials/content/chapter-card-badge.html.twig' with { card_page: child } only %}
        </a>
        {% endfor %}
    </div>
    {% endif %}
    {% endfor %}
{% endif %}
