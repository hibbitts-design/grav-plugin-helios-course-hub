{#
 # Plugin override of partials/footer.html.twig (helios theme)
 # Changes from theme original:
 #   1. git_path_prefix uses github_server plugin variable to support GitHub (blob) and Codeberg (src/branch) view links; icon uses github_link_icon plugin variable (search: PLUGIN CHANGE 1)
 #   2. Footer attribution text includes Helios Course Hub link, toggled by show_plugin_credits (search: PLUGIN CHANGE 2)
 #   3. Git edit link suppressed via ?edit_link=false or ?hidegitlink=true URL params (search: PLUGIN CHANGE 3)
 #   4. Creative Commons license above the credit line, from the Display CC License setting (search: PLUGIN CHANGE 4)
 #}
<footer class="mt-16 py-8 border-t border-gray-200 dark:border-gray-700">

    {# View on GitHub/Codeberg link #}
        {% if theme_config.github.enabled and theme_config.github.edit_link and not hide_git_link %}{# PLUGIN CHANGE 3: suppressed via ?edit_link=false or ?hidegitlink=true #}
        {% set file_path = page.filePathClean %}
        {% set prefix = theme_config.github.path_prefix %}
        {% if prefix and file_path starts with prefix %}
            {% set file_path = file_path[prefix|length:] %}
        {% endif %}
        {% set git_path_prefix = (github_server == 'github.com') ? (github_link_mode == 'edit' ? 'edit' : 'blob') : (github_link_mode == 'edit' ? '_edit' : 'src/branch') %}{# PLUGIN CHANGE 1: github_server supports GitHub and Codeberg; github_link_mode supports view/edit #}
        <div class="mb-4 border-gray-200 dark:border-gray-700 text-center">
            <a href="https://{{ github_server }}/{{ theme_config.github.repo|trim('/') }}/{{ git_path_prefix }}/{{ theme_config.github.branch }}/{{ file_path }}"
               target="_blank"
               rel="noopener noreferrer"
               class="edit-page-link inline-flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 hover:text-primary">
                <span aria-hidden="true">{{ svg_icon(github_link_icon ?: 'tabler/file-text.svg', 'w-4 h-4')|raw }}</span>
                {{ theme_config.github.edit_text ?: 'THEME_HELIOS.EDIT_PAGE'|t }}<span class="sr-only"> {{ 'PLUGIN_HELIOS_COURSE_HUB.OPENS_IN_NEW_TAB'|t }}</span>
            </a>
        </div>
        {% endif %}

    {# Creative Commons license for the site's content (the Display CC License setting) #}{# PLUGIN CHANGE 4 #}
    {% include 'partials/cc-license.html.twig' %}

    {% if show_plugin_credits and not chromeless %}{# PLUGIN CHANGE 2: footer attribution includes Helios Course Hub link, toggled by show_plugin_credits; also suppressed when embedded #}
    {# the credit line, as one translatable sentence (FOOTER_CREDITS in languages.yaml), with its four links filled in as %1$s to %2$s, %3$s and %4$s #}
    {% set credit_grav = '<a href="https://getgrav.org" target="_blank" rel="nofollow noopener noreferrer" class="hover:underline">Grav<span class="sr-only"> ' ~ ('PLUGIN_HELIOS_COURSE_HUB.OPENS_IN_NEW_TAB'|t) ~ '</span></a>' %}
    {% set credit_helios = '<a href="https://getgrav.org/premium/helios" target="_blank" rel="nofollow noopener noreferrer" class="hover:underline">Grav Premium Helios<span class="sr-only"> ' ~ ('PLUGIN_HELIOS_COURSE_HUB.OPENS_IN_NEW_TAB'|t) ~ '</span></a>' %}
    {% set credit_course_hub = '<a href="https://github.com/hibbitts-design/grav-skeleton-helios-course-hub" target="_blank" rel="nofollow noopener noreferrer" class="hover:underline">Helios Course Hub<span class="sr-only"> ' ~ ('PLUGIN_HELIOS_COURSE_HUB.OPENS_IN_NEW_TAB'|t) ~ '</span></a>' %}
    {% set credit_author = '<a href="https://hibbittsdesign.org" target="_blank" rel="nofollow noopener noreferrer" class="hover:underline">hibbittsdesign.org<span class="sr-only"> ' ~ ('PLUGIN_HELIOS_COURSE_HUB.OPENS_IN_NEW_TAB'|t) ~ '</span></a>' %}
    <p class="text-center text-sm text-gray-500 dark:text-gray-400">{{ 'PLUGIN_HELIOS_COURSE_HUB.FOOTER_CREDITS'|t(credit_grav, credit_helios, credit_course_hub, credit_author)|raw }}</p>
    {% endif %}
</footer>
