{% extends helios_base_simple %}

{% block content %}
    {# Page header #}
    <header class="mb-8 pb-8 border-b border-gray-200 dark:border-gray-800">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white">
            {{ page.title }}
        </h1>
        {% if page.header.description %}
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
            {{ page.header.description }}
        </p>
        {% endif %}
    </header>

    {# Split page content above/below course list using === delimiter #}
    {# Grav treats === as its summary separator and strips it from page.content, #}
    {# so page.content never contains <p>===</p>. Use page.summary() for content_above #}
    {# and derive content_below as the remainder of page.content. #}
    {% set raw = page.rawMarkdown() %}
    {% if '===' in raw %}
        {% set content_above = page.summary() %}
        {% set full = page.content %}
        {% set content_below = (full starts with content_above) ? (full|slice(content_above|length))|trim : null %}
    {% else %}
        {% set content_above = page.content %}
        {% set content_below = null %}
    {% endif %}

    {# Page content above course list #}
    {% if content_above|trim %}
        <article class="prose prose-lg dark:prose-invert max-w-none mb-8">
            {{ content_above|raw }}
        </article>
    {% endif %}

    {# Auto-generated course cards from version folders, with optional grouping via group: "Label" in version page frontmatter #}
    {% if helios_version_info.versions is defined and helios_version_info.versions|length > 0 %}
    {% set cols = page.header.cards_per_row|default(1) %}
    {% set colClass = {
        1: 'grid-cols-1',
        2: 'sm:grid-cols-2',
        3: 'sm:grid-cols-2 lg:grid-cols-3'
    } %}
    {% set gridClass = 'course-card-grid grid gap-4 ' ~ (colClass[cols] ?? 'grid-cols-1') ~ (cols == 2 ? ' course-card-grid--cols-2' : (cols == 3 ? ' course-card-grid--cols-3' : '')) %}

    {# Collect valid versions with their pages and group assignments #}
    {% set items = [] %}
    {% for version in helios_version_info.versions %}
        {% set vp = pages.find('/' ~ version.id) %}
        {% if vp %}
            {% set items = items|merge([{'v': version, 'vp': vp, 'vh': vp.children.first(), 'g': vp.header.group ?? ''}]) %}
        {% endif %}
    {% endfor %}

    {# Build group order and grouped items; ungrouped ('') always appears first #}
    {% set groups = {} %}
    {% set group_order = [] %}
    {% for item in items %}
        {% set g = item.g %}
        {% if g not in group_order %}
            {% set group_order = group_order|merge([g]) %}
            {% set groups = groups|merge({(g): []}) %}
        {% endif %}
        {% set groups = groups|merge({(g): groups[g]|merge([item])}) %}
    {% endfor %}

    {% for g in group_order %}
    {% if g %}
    <div class="pt-6 mb-10">
        <h2 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-4">{{ g }}</h2>
        <div class="{{ gridClass }}">
            {% for item in groups[g] %}
                {% set course_image = item.vp.header.image ? item.vp.media[item.vp.header.image] : null %}
                {% include 'partials/course-card.html.twig' with {
                    title: item.v.label,
                    link: item.vh ? item.vh.url : item.v.url,
                    icon: item.vp.header.icon|default(page.header.card_icon),
                    description: item.vp.header.description|default(null),
                    instructor: item.vp.header.instructor|default(null),
                    badge_label: item.vp.header.badge_label|default(null),
                    badge_color: item.vp.header.badge_color|default('default'),
                    image: course_image,
                    image_layout: (cols == 3) ? 'top' : page.header.card_image_layout|default('side'),
                    card_description_lines: page.header.card_description_lines|default(3)
                } only %}
            {% endfor %}
        </div>
    </div>
    {% else %}
    <div class="{{ gridClass }} {% if group_order|length > 1 %}mb-10{% else %}mb-8{% endif %}">
        {% for item in groups[g] %}
            {% set course_image = item.vp.header.image ? item.vp.media[item.vp.header.image] : null %}
            {% include 'partials/course-card.html.twig' with {
                title: item.v.label,
                link: item.vh ? item.vh.url : item.v.url,
                icon: item.vp.header.icon|default(page.header.card_icon),
                description: item.vp.header.description|default(null),
                instructor: item.vp.header.instructor|default(null),
                badge_label: item.vp.header.badge_label|default(null),
                badge_color: item.vp.header.badge_color|default('default'),
                image: course_image,
                image_layout: (cols == 3) ? 'top' : page.header.card_image_layout|default('side'),
                card_description_lines: page.header.card_description_lines|default(3)
            } only %}
        {% endfor %}
    </div>
    {% endif %}
    {% endfor %}
    {% endif %}

    {# Page content below course list #}
    {% if content_below and content_below|trim %}
        <article class="prose prose-lg dark:prose-invert max-w-none mt-8">
            {{ content_below|raw }}
        </article>
    {% endif %}
{% endblock %}
